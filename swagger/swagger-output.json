{
  "swagger": "2.0",
  "info": {
    "title": "API REST E-commerce - Documentación",
    "description": "API colaborativa con Node.js, Express y TypeScript",
    "version": "1.0.0"
  },
  "host": "localhost:3000",
  "basePath": "/",
  "schemes": [
    "http"
  ],
  "securityDefinitions": {
    "ApiKeyAuth": {
      "type": "apiKey",
      "in": "header",
      "name": "x-api-key",
      "description": "Ingresa tu API Key para autorizar endpoints protegidos"
    }
  },
  "paths": {
    "/api/categories/": {
      "get": {
        "tags": [
          "Categorias"
        ],
        "summary": "Obtener todas las categorías",
        "description": "Retorna la lista completa de todas las categorías disponibles en memoria",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "post": {
        "tags": [
          "Categorias"
        ],
        "summary": "Crear una categoría",
        "description": "Crea y registra una nueva categoría en memoria",
        "parameters": [
          {
            "name": "x-api-key",
            "in": "header",
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "description": "Datos de la nueva categoría",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "example": "Electrodomésticos"
                },
                "description": {
                  "type": "string",
                  "example": "Neveras, lavadoras y microondas"
                }
              }
            }
          }
        ],
        "responses": {
          "401": {
            "description": "Unauthorized"
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ]
      }
    },
    "/api/categories/{id}": {
      "get": {
        "tags": [
          "Categorias"
        ],
        "summary": "Obtener categoría por ID",
        "description": "Busca y retorna una sola categoría según su ID numérico",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "integer",
            "description": "ID de la categoría a consultar",
            "example": 1
          }
        ],
        "responses": {
          "default": {
            "description": ""
          }
        }
      },
      "put": {
        "tags": [
          "Categorias"
        ],
        "summary": "Actualizar una categoría",
        "description": "Actualiza el nombre o la descripción de una categoría existente",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "integer",
            "description": "ID de la categoría a actualizar",
            "example": 1
          },
          {
            "name": "x-api-key",
            "in": "header",
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "description": "Datos a modificar",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "example": "Tecnología Avanzada"
                },
                "description": {
                  "type": "string",
                  "example": "Gadgets y computadoras de última generación"
                }
              }
            }
          }
        ],
        "responses": {
          "401": {
            "description": "Unauthorized"
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ]
      },
      "delete": {
        "tags": [
          "Categorias"
        ],
        "summary": "Eliminar una categoría",
        "description": "Elimina una categoría del sistema por su ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "integer",
            "description": "ID de la categoría a eliminar",
            "example": 1
          },
          {
            "name": "x-api-key",
            "in": "header",
            "type": "string"
          }
        ],
        "responses": {
          "401": {
            "description": "Unauthorized"
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ]
      }
    }
  }
}